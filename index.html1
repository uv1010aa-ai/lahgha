
```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>لوحة التحكم | لَحْقها</title>

    <style>

        :root {
            --primary: #1e3a5f;
            --primary-dark: #16314f;
            --success: #2e7d32;
            --danger: #c62828;
            --warning: #9a6100;
            --background: #f5f7fb;
            --white: #fff;
            --text: #333;
            --muted: #6b7280;
            --border: #e2e6ec;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Tahoma, Arial, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .admin-header {
            background: var(--primary);
            color: #fff;
            padding: 25px 20px;
        }

        .header-content {
            width: min(1200px, calc(100% - 30px));
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .admin-header h1 {
            margin: 0 0 5px;
            font-size: 27px;
        }

        .admin-header p {
            margin: 0;
            opacity: .9;
        }

        .header-links {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .header-link {
            color: #fff;
            text-decoration: none;
            padding: 10px 15px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 9px;
            white-space: nowrap;
        }

        .header-link:hover {
            background: rgba(255,255,255,.1);
        }

        .admin-container {
            width: min(1200px, calc(100% - 30px));
            margin: 30px auto 60px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: var(--white);
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 6px 20px rgba(0,0,0,.07);
        }

        .stat-card span {
            display: block;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .stat-card strong {
            font-size: 28px;
            color: var(--primary);
        }

        .tabs {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .tab {
            border: 1px solid var(--border);
            background: #fff;
            padding: 11px 16px;
            border-radius: 9px;
            font-family: inherit;
            cursor: pointer;
            font-weight: bold;
        }

        .tab.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .requests-box {
            background: var(--white);
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
        }

        .requests-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .requests-head h2 {
            margin: 0;
            color: var(--primary);
        }

        .refresh-btn {
            border: 0;
            min-width: 120px;
            background: var(--primary);
            color: #fff;
            padding: 10px 15px;
            border-radius: 9px;
            font-family: inherit;
            cursor: pointer;
        }

        .empty {
            text-align: center;
            padding: 50px 20px;
            color: var(--muted);
        }

        .request-card {
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 15px;
            background: #fff;
        }

        .request-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 15px;
        }

        .request-top h3 {
            margin: 0 0 6px;
            color: var(--primary);
        }

        .request-id {
            font-size: 12px;
            color: var(--muted);
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .status.pending {
            background: #fff4dc;
            color: var(--warning);
        }

        .status.approved {
            background: #e9f7eb;
            color: var(--success);
        }

        .status.rejected {
            background: #fdeaea;
            color: var(--danger);
        }

        .request-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px 20px;
            padding: 15px;
            background: #f8fafc;
            border-radius: 12px;
        }

        .request-field strong {
            color: var(--primary);
        }

        .request-image-box {
            margin-bottom: 18px;
            text-align: center;
        }

        .request-image {
            width: 220px;
            max-width: 100%;
            height: 220px;
            object-fit: contain;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: #f8fafc;
        }

        .description {
            margin-top: 15px;
            padding: 15px;
            background: #fafafa;
            border-radius: 10px;
            line-height: 1.8;
        }

        .admin-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .admin-actions button {
            border: 0;
            padding: 10px 15px;
            border-radius: 9px;
            color: #fff;
            font-family: inherit;
            font-weight: bold;
            cursor: pointer;
        }

        .approve-btn {
            background: var(--success);
        }

        .reject-btn {
            background: var(--danger);
        }

        .delete-btn {
            background: #555;
        }

        .commission-box {
            display: none;
            margin-top: 15px;
            padding: 15px;
            background: #f5f8fc;
            border-radius: 12px;
        }

        .commission-box.show {
            display: block;
        }

        .commission-box label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: var(--primary);
        }

        .commission-box input {
            width: 220px;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-family: inherit;
            margin-bottom: 10px;
        }

        .confirm-approve {
            padding: 10px 15px;
            border: 0;
            border-radius: 8px;
            background: var(--success);
            color: #fff;
            font-family: inherit;
            font-weight: bold;
            cursor: pointer;
        }

        .published-box {
            margin-top: 15px;
            padding: 15px;
            border-radius: 12px;
            background: #eef7ef;
            border: 1px solid #c5dfc8;
        }

        .published-box strong {
            color: var(--success);
        }

        .admin-footer {
            text-align: center;
            color: var(--muted);
            padding: 20px;
            font-size: 13px;
        }

        @media (max-width: 950px) {

            .stats {
                grid-template-columns: repeat(3, 1fr);
            }

        }

        @media (max-width: 800px) {

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .header-content {
                flex-direction: column;
                text-align: center;
            }

            .request-grid {
                grid-template-columns: 1fr;
            }

            .header-links {
                justify-content: center;
            }

        }

        @media (max-width: 500px) {

            .stats {
                grid-template-columns: 1fr;
            }

            .admin-container {
                width: calc(100% - 20px);
            }

            .requests-box {
                padding: 17px;
            }

            .request-top {
                flex-direction: column;
            }

            .header-link {
                width: 100%;
                text-align: center;
            }

            .commission-box input {
                width: 100%;
            }

        }

    </style>

</head>


<body>


<header class="admin-header">

    <div class="header-content">

        <div>

            <h1>
                🔐 لوحة التحكم — لَحْقها
            </h1>

            <p>
                إدارة أصحاب السلع والمنتجات قبل عرضها للمشتري
            </p>

        </div>

        <div class="header-links">

            <a
                href="../index.html"
                class="header-link"
            >
                🛍️ متجر المشتري
            </a>

            <a
                href="../seller/offer.html"
                class="header-link"
            >
                📦 صفحة أصحاب السلع
            </a>

        </div>

    </div>

</header>


<main class="admin-container">


    <section class="stats">

        <div class="stat-card">

            <span>
                إجمالي الطلبات
            </span>

            <strong id="total-requests">
                0
            </strong>

        </div>


        <div class="stat-card">

            <span>
                قيد المراجعة
            </span>

            <strong id="pending-requests">
                0
            </strong>

        </div>


        <div class="stat-card">

            <span>
                تمت الموافقة
            </span>

            <strong id="approved-requests">
                0
            </strong>

        </div>


        <div class="stat-card">

            <span>
                مرفوضة
            </span>

            <strong id="rejected-requests">
                0
            </strong>

        </div>


        <div class="stat-card">

            <span>
                منشورة
            </span>

            <strong id="published-products">
                0
            </strong>

        </div>

    </section>


    <div class="tabs">

        <button
            class="tab active"
            onclick="setFilter('all', this)"
        >
            📋 الكل
        </button>

        <button
            class="tab"
            onclick="setFilter('pending', this)"
        >
            ⏳ قيد المراجعة
        </button>

        <button
            class="tab"
            onclick="setFilter('approved', this)"
        >
            ✅ معتمدة
        </button>

        <button
            class="tab"
            onclick="setFilter('rejected', this)"
        >
            ❌ مرفوضة
        </button>

    </div>


    <section class="requests-box">

        <div class="requests-head">

            <h2>
                📦 طلبات أصحاب السلع
            </h2>

            <button
                class="refresh-btn"
                onclick="refreshAdmin()"
            >
                🔄 تحديث
            </button>

        </div>


        <div id="requests-container"></div>

    </section>

</main>


<footer class="admin-footer">

    © 2026 لَحْقها — لوحة التحكم

</footer>


<script>


let currentFilter = "all";


// =========================
// قراءة الطلبات
// =========================

function getRequests() {

    let requests = [];

    try {
        requests = JSON.parse(
            localStorage.getItem("sellerRequests") || "[]"
        );
        if (!Array.isArray(requests)) requests = [];
    } catch (error) {
        requests = [];
    }

    // ترحيل بيانات الاختبار القديمة: أي طلب كان يُحفظ كـ"منشور"
    // قبل الموافقة يتحول الآن إلى "قيد المراجعة".
    let changed = false;
    requests = requests.map(request => {
        if (request.status === "منشور" && !request.approvedAt) {
            changed = true;
            return { ...request, status: "قيد المراجعة", published: false };
        }
        return request;
    });

    if (changed) {
        localStorage.setItem("sellerRequests", JSON.stringify(requests));
    }

    return requests;
}


// =========================
// حفظ الطلبات
// =========================

function saveRequests(requests) {

    localStorage.setItem(
        "sellerRequests",
        JSON.stringify(requests)
    );
}


// =========================
// قراءة المنتجات المنشورة
// =========================

function getPublishedProducts() {

    let products = [];

    try {
        products = JSON.parse(
            localStorage.getItem("publishedProducts") || "[]"
        );
        if (!Array.isArray(products)) products = [];
    } catch (error) {
        products = [];
    }

    const requests = (() => {
        try {
            const value = JSON.parse(localStorage.getItem("sellerRequests") || "[]");
            return Array.isArray(value) ? value : [];
        } catch (error) {
            return [];
        }
    })();

    // لا يبقى أي منتج في واجهة المشتري إلا إذا كان طلبه معتمدًا.
    products = products.filter(product => {
        const request = requests.find(r =>
            String(r.id) === String(product.requestId)
        );
        return request && request.status === "تمت الموافقة";
    });

    // تنظيف أي بيانات خاصة قديمة كانت محفوظة داخل المنتجات العامة.
    products = products.map(product => {
        const clean = { ...product };
        delete clean.sellerName;
        delete clean.phone;
        delete clean.city;
        delete clean.commission;
        delete clean.sellerImage;
        delete clean.ownerImage;
        delete clean.author;
        return clean;
    });

    localStorage.setItem("publishedProducts", JSON.stringify(products));
    return products;
}


// =========================
// حفظ المنتجات المنشورة
// =========================

function savePublishedProducts(products) {

    localStorage.setItem(
        "publishedProducts",
        JSON.stringify(products)
    );
}


// =========================
// حماية النصوص
// =========================

function safe(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


// =========================
// الصورة
// =========================

function getRequestImage(request) {

    return (
        request.image ||
        request.imageUrl ||
        request.productImage ||
        request.photo ||
        request.productPhoto ||
        ""
    );
}


// =========================
// تحديث الإحصائيات
// =========================

function updateStats(requests) {

    document.getElementById(
        "total-requests"
    ).textContent =
        requests.length;


    document.getElementById(
        "pending-requests"
    ).textContent =
        requests.filter(
            r =>
                r.status === "قيد المراجعة"
        ).length;


    document.getElementById(
        "approved-requests"
    ).textContent =
        requests.filter(
            r =>
                r.status === "تمت الموافقة"
        ).length;


    document.getElementById(
        "rejected-requests"
    ).textContent =
        requests.filter(
            r =>
                r.status === "مرفوض"
        ).length;


    document.getElementById(
        "published-products"
    ).textContent =
        getPublishedProducts().length;
}


// =========================
// حالة الطلب
// =========================

function statusClass(status) {

    if (
        status === "تمت الموافقة"
    ) {
        return "approved";
    }

    if (
        status === "مرفوض"
    ) {
        return "rejected";
    }

    return "pending";
}


// =========================
// الفلتر
// =========================

function setFilter(
    filter,
    button
) {

    currentFilter =
        filter;


    document
        .querySelectorAll(".tab")
        .forEach(
            tab =>
                tab.classList.remove(
                    "active"
                )
        );


    button.classList.add(
        "active"
    );


    loadRequests();
}


// =========================
// مطابقة الفلتر
// =========================

function matchesFilter(request) {

    if (
        currentFilter === "all"
    ) {
        return true;
    }


    if (
        currentFilter === "pending" &&
        request.status === "قيد المراجعة"
    ) {
        return true;
    }


    if (
        currentFilter === "approved" &&
        request.status === "تمت الموافقة"
    ) {
        return true;
    }


    if (
        currentFilter === "rejected" &&
        request.status === "مرفوض"
    ) {
        return true;
    }


    return false;
}


// =========================
// تحديث يدوي للوحة التحكم
// =========================

function refreshAdmin() {
    const button = document.querySelector(".refresh-btn");
    if (button) {
        button.disabled = true;
        button.textContent = "⏳ جاري التحديث...";
    }

    loadRequests();

    setTimeout(() => {
        if (button) {
            button.disabled = false;
            button.textContent = "🔄 تحديث";
        }
    }, 300);
}

// =========================
// تحميل الطلبات
// =========================

function loadRequests() {

    const allRequests =
        getRequests();


    updateStats(
        allRequests
    );


    const requests =
        allRequests.filter(
            matchesFilter
        );


    const container =
        document.getElementById(
            "requests-container"
        );


    if (
        requests.length === 0
    ) {

        container.innerHTML = `

            <div class="empty">

                <div style="font-size:45px;">
                    📭
                </div>

                <h3>
                    لا توجد طلبات في هذا القسم
                </h3>

                <p>
                    ستظهر الطلبات هنا عندما تصل إلى المنصة.
                </p>

            </div>

        `;

        return;
    }


    container.innerHTML =
        requests
            .slice()
            .reverse()
            .map(
                request =>
                    createRequestCard(
                        request
                    )
            )
            .join("");
}


// =========================
// بطاقة الطلب
// =========================

function createRequestCard(request) {

    const publishedProducts =
        getPublishedProducts();


    const isPublished =
        publishedProducts.some(
            product =>
                product.requestId ===
                request.id
        );


    const image =
        getRequestImage(
            request
        );


    return `

        <article class="request-card">


            <div class="request-top">

                <div>

                    <h3>
                        📦 ${safe(request.productName)}
                    </h3>

                    <div class="request-id">

                        رقم الطلب:
                        ${safe(request.id)}

                    </div>

                </div>


                <span
                    class="status ${statusClass(request.status)}"
                >
                    ${safe(request.status)}
                </span>

            </div>


            ${
                image
                ?
                `

                <div class="request-image-box">

                    <img
                        src="${safe(image)}"
                        class="request-image"
                        alt="${safe(request.productName)}"
                    >

                </div>

                `
                :
                ""
            }


            <div class="request-grid">


                <div class="request-field">

                    <strong>
                        صاحب السلعة:
                    </strong>

                    ${safe(
                        request.sellerName
                    )}

                </div>


                <div class="request-field">

                    <strong>
                        رقم التواصل:
                    </strong>

                    ${safe(
                        request.phone
                    )}

                </div>


                <div class="request-field">

                    <strong>
                        المدينة:
                    </strong>

                    ${safe(
                        request.city
                    )}

                </div>


                <div class="request-field">

                    <strong>
                        القسم:
                    </strong>

                    ${safe(
                        request.category
                    )}

                </div>


                <div class="request-field">

                    <strong>
                        السعر:
                    </strong>

                    ${safe(
                        request.price
                    )}
                    ريال

                </div>


                <div class="request-field">

                    <strong>
                        الكمية:
                    </strong>

                    ${safe(
                        request.quantity
                    )}

                </div>


                ${
                    request.agreementAccepted
                    ? `
                    <div class="request-field">
                        <strong>الاتفاقية:</strong>
                        ✅ تمت موافقة البائع
                        ${request.agreementAcceptedAt ? ` — ${safe(new Date(request.agreementAcceptedAt).toLocaleString("ar-SA"))}` : ""}
                    </div>
                    `
                    : `
                    <div class="request-field">
                        <strong>الاتفاقية:</strong>
                        ⚠️ لم تُسجل موافقة البائع
                    </div>
                    `
                }


                ${
                    request.commission
                    ?
                    `

                    <div class="request-field">

                        <strong>
                            العمولة:
                        </strong>

                        ${safe(
                            request.commission
                        )}

                    </div>

                    `
                    :
                    ""
                }


            </div>


            <div class="description">

                <strong>
                    وصف السلعة:
                </strong>

                <p>
                    ${safe(
                        request.description
                    )}
                </p>


                ${
                    request.notes
                    ?
                    `

                    <strong>
                        ملاحظات:
                    </strong>

                    <p>
                        ${safe(
                            request.notes
                        )}
                    </p>

                    `
                    :
                    ""
                }

            </div>


            ${
                request.status === "قيد المراجعة"
                ?
                `

                <div class="admin-actions">

                    <button
                        class="approve-btn"
                        onclick="showCommission('${safe(request.id)}')"
                    >
                        ✅ قبول ونشر
                    </button>


                    <button
                        class="reject-btn"
                        onclick="rejectRequest('${safe(request.id)}')"
                    >
                        ❌ رفض الطلب
                    </button>


                    <button
                        class="delete-btn"
                        onclick="deleteRequest('${safe(request.id)}')"
                    >
                        🗑️ حذف
                    </button>

                </div>


                <div
                    class="commission-box"
                    id="commission-${safe(request.id)}"
                >

                    <label>
                        العمولة المتفق عليها
                    </label>


                    <input
                        type="text"
                        id="commission-input-${safe(request.id)}"
                        placeholder="مثال: 10% أو 50 ريال"
                    >


                    <br>


                    <button
                        class="confirm-approve"
                        onclick="approveRequest('${safe(request.id)}')"
                    >
                        🚀 اعتماد ونشر مباشرة
                    </button>

                </div>

                `
                :
                ""
            }


            ${
                request.status === "تمت الموافقة"
                ?
                `

                <div class="published-box">

                    ${
                        isPublished
                        ?
                        `

                        <strong>
                            🟢 المنتج منشور في متجر المشتري
                        </strong>

                        <br>

                        المنتج ظاهر الآن في القسم:
                        ${safe(request.category)}

                        `
                        :
                        `

                        <strong>
                            🟡 تمت الموافقة
                        </strong>

                        <br>

                        لم يتم العثور على المنتج المنشور.

                        `
                    }

                </div>


                <div class="admin-actions">

                    ${
                        isPublished
                        ?
                        `

                        <button
                            class="delete-btn"
                            onclick="unpublishProduct('${safe(request.id)}')"
                        >
                            👁️ إخفاء من المتجر
                        </button>

                        `
                        :
                        `

                        <button
                            class="approve-btn"
                            onclick="publishProduct('${safe(request.id)}')"
                        >
                            🛍️ نشر الآن
                        </button>

                        `
                    }


                    <button
                        class="delete-btn"
                        onclick="deleteRequest('${safe(request.id)}')"
                    >
                        🗑️ حذف الطلب
                    </button>

                </div>

                `
                :
                ""
            }


            ${
                request.status === "مرفوض"
                ?
                `

                <div class="admin-actions">

                    <button
                        class="delete-btn"
                        onclick="deleteRequest('${safe(request.id)}')"
                    >
                        🗑️ حذف الطلب
                    </button>

                </div>

                `
                :
                ""
            }


        </article>

    `;
}


// =========================
// إظهار خانة العمولة
// =========================

function showCommission(id) {

    const box =
        document.getElementById(
            "commission-" + id
        );


    if (box) {

        box.classList.toggle(
            "show"
        );
    }
}


// =========================
// اعتماد ونشر تلقائي
// =========================

function approveRequest(id) {

    const requests =
        getRequests();


    const request =
        requests.find(
            r =>
                String(r.id) ===
                String(id)
        );


    if (!request) {

        alert(
            "لم يتم العثور على الطلب."
        );

        return;
    }


    const input =
        document.getElementById(
            "commission-input-" + id
        );


    const commission =
        input
        ?
        input.value.trim()
        :
        "";


    if (!commission) {

        alert(
            "اكتب العمولة المتفق عليها أولًا."
        );

        return;
    }


    // اعتماد الطلب

    request.status =
        "تمت الموافقة";


    request.commission =
        commission;


    request.approvedAt =
        new Date().toISOString();


    // نشر المنتج مباشرة

    const published =
        publishRequestProduct(
            request
        );


    if (!published) {

        alert(
            "تم اعتماد الطلب ولكن تعذر نشره."
        );

        saveRequests(
            requests
        );

        loadRequests();

        return;
    }


    request.published =
        true;


    request.publishedAt =
        new Date().toISOString();


    saveRequests(
        requests
    );


    loadRequests();


    alert(
        "✅ تمت الموافقة ونُشرت السلعة مباشرة في قسمها."
    );
}


// =========================
// إنشاء المنتج المنشور
// =========================

function publishRequestProduct(
    request
) {

    const products =
        getPublishedProducts();


    const existingIndex =
        products.findIndex(
            product =>
                String(
                    product.requestId
                ) ===
                String(request.id)
        );


    const image =
        getRequestImage(
            request
        );


    const product = {

        id:
            existingIndex >= 0
            ?
            products[existingIndex].id
            :
            "PROD-" +
            Date.now(),

        requestId:
            request.id,

        name:
            request.productName,

        title:
            request.productName,

        category:
            String(
                request.category || ""
            ).trim(),

        price:
            Number(
                request.price
            ) || 0,

        quantity:
            Number(
                request.quantity
            ) || 1,

        description:
            request.description ||
            "",

        image:
            image,

        imageUrl:
            image,

        images:
            request.images ||
            (
                image
                ?
                [image]
                :
                []
            ),

        available:
            true,

        active:
            true,

        publishedAt:
            new Date().toISOString()

    };


    if (
        existingIndex >= 0
    ) {

        products[
            existingIndex
        ] = product;

    } else {

        products.push(
            product
        );
    }


    savePublishedProducts(
        products
    );


    return true;
}


// =========================
// نشر منتج تمت الموافقة عليه
// =========================

function publishProduct(id) {

    const requests =
        getRequests();


    const request =
        requests.find(
            r =>
                String(r.id) ===
                String(id)
        );


    if (!request) {
        return;
    }


    if (
        request.status !==
        "تمت الموافقة"
    ) {

        alert(
            "يجب اعتماد السلعة أولًا."
        );

        return;
    }


    const published =
        publishRequestProduct(
            request
        );


    if (published) {

        request.published =
            true;


        request.publishedAt =
            new Date().toISOString();


        saveRequests(
            requests
        );


        loadRequests();


        alert(
            "🛍️ تم نشر المنتج في القسم."
        );
    }
}


// =========================
// إخفاء المنتج
// =========================

function unpublishProduct(id) {

    if (
        !confirm(
            "هل تريد إخفاء هذا المنتج من متجر المشتري؟"
        )
    ) {
        return;
    }


    let products =
        getPublishedProducts();


    products =
        products.filter(
            product =>
                String(
                    product.requestId
                ) !==
                String(id)
        );


    savePublishedProducts(
        products
    );


    const requests =
        getRequests();


    const request =
        requests.find(
            r =>
                String(r.id) ===
                String(id)
        );


    if (request) {

        request.published =
            false;


        saveRequests(
            requests
        );
    }


    loadRequests();
}


// =========================
// رفض الطلب
// =========================

function rejectRequest(id) {

    if (
        !confirm(
            "هل تريد رفض هذا الطلب؟"
        )
    ) {
        return;
    }


    const requests =
        getRequests();


    const request =
        requests.find(
            r =>
                String(r.id) ===
                String(id)
        );


    if (!request) {
        return;
    }


    request.status =
        "مرفوض";


    request.published =
        false;


    // إذا كان المنتج منشورًا نحذفه

    let products =
        getPublishedProducts();


    products =
        products.filter(
            product =>
                String(
                    product.requestId
                ) !==
                String(id)
        );


    savePublishedProducts(
        products
    );


    saveRequests(
        requests
    );


    loadRequests();


    alert(
        "تم رفض الطلب."
    );
}


// =========================
// حذف الطلب
// =========================

function deleteRequest(id) {

    if (
        !confirm(
            "هل تريد حذف هذا الطلب نهائيًا؟"
        )
    ) {
        return;
    }


    let requests =
        getRequests();


    requests =
        requests.filter(
            r =>
                String(r.id) !==
                String(id)
        );


    saveRequests(
        requests
    );


    // حذف المنتج المنشور المرتبط

    let products =
        getPublishedProducts();


    products =
        products.filter(
            product =>
                String(
                    product.requestId
                ) !==
                String(id)
        );


    savePublishedProducts(
        products
    );


    loadRequests();
}


// =========================
// التشغيل
// =========================

loadRequests();

</script>

</body>

</html>
```
